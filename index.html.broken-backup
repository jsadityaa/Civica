<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Civica</title>
    <script>
      (function () {
        try {
          if (localStorage.getItem('datahub-theme') === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (error) {
          console.warn('Theme preference unavailable.', error);
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,600&family=Inter:wght@400;500;600;700;800&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="./styles.css">
  </head>
  <body class="civica-homepage">
    <header class="global-header">
      <div class="global-header-inner">
        <a href="./index.html" class="brand" aria-label="Civica home">Civica</a>
        <nav class="global-nav" aria-label="Main navigation">
          <a href="./index.html" class="global-nav-link active" aria-current="page">Features</a>
          <a href="./elections.html" class="global-nav-link">Elections</a>
          <a href="./misc.html" class="global-nav-link">Misc.</a>
          <div class="global-nav-dropdown">
            <button class="global-nav-link global-nav-dropdown__trigger" type="button" aria-expanded="false" aria-controls="about-dropdown">
              About Us
            </button>
            <div class="global-nav-dropdown__menu" id="about-dropdown" hidden>
              <a href="#our-mission" class="global-nav-dropdown__link">Our mission</a>
              <a href="#our-team" class="global-nav-dropdown__link">Our team</a>
            </div>
          </div>
          <a href="./settings.html" class="global-nav-link">Settings</a>
        </nav>
        <div class="account-ui" aria-label="Account controls">
          <button class="login-button" type="button">Log In</button>
          <button class="account-button" type="button" aria-label="Account">
            <span class="account-avatar">A</span>
            <span class="account-label">Account</span>
          </button>
        </div>
      </div>
    </header>

    <main class="civica-homepage__main">
      <section class="civica-homepage__hero">
        <div class="civica-homepage__hero-inner">
          <h1 class="civica-homepage__headline">Projections, forecasting, and trends, all in one.</h1>
          <img class="civica-homepage__hero-map" src="./assets/homepage-map-v2.png" alt="United States election map">
        </div>
      </section>

      <section class="civica-homepage__section">
        <div class="civica-homepage__section-stack">
          <p class="civica-homepage__section-eyebrow">OVERVIEW</p>
          <p class="civica-homepage__section-caption">Here's a basic rundown of our services.</p>
        </div>

        <div class="civica-homepage__services">
          <article class="civica-service-item">
            <div class="civica-service-item__media">
              <img src="./assets/service-election-results.png" alt="Election Results icon">
            </div>
            <div class="civica-service-item__content">
              <h3>Election Results</h3>
              <p>We provide election results from all around the United States. From time to time, we may even include international elections such as ones from Canada and the EU.</p>
            </div>
          </article>

          <article class="civica-service-item">
            <div class="civica-service-item__media">
              <img src="./assets/service-opinion-pieces.png" alt="Opinion Pieces icon">
            </div>
            <div class="civica-service-item__content">
              <h3>Opinion Pieces</h3>
              <p>At times, our site developers enjoy writing little op-eds of their own to share their thoughts on social and economic issues. We will soon open this up to allow users to create their own op-eds and upload them to a forum.</p>
            </div>
          </article>

          <article class="civica-service-item">
            <div class="civica-service-item__media">
              <img src="./assets/service-forecasting.png" alt="Forecasting icon">
            </div>
            <div class="civica-service-item__content">
              <h3>Forecasting</h3>
              <p>One of our other primary services are forecasts for upcoming elections. If you're wondering what the odds are of your favorite candidate winning something, it's all here.</p>
            </div>
          </article>

          <article class="civica-service-item">
            <div class="civica-service-item__media">
              <img src="./assets/service-timelines.png" alt="Timelines icon">
            </div>
            <div class="civica-service-item__content">
              <h3>Timelines</h3>
              <p>As a method to keep you up to speed on the goings-on, we provide timelines in order for you to know when major elections, debates, deadlines, and key events are going to take place.</p>
            </div>
          </article>

          <article class="civica-service-item">
            <div class="civica-service-item__media">
              <img src="./assets/service-news.png" alt="News icon">
            </div>
            <div class="civica-service-item__content">
              <h3>News</h3>
              <p>For us, data isn't just numbers, charts and statistics. We think it's also necessary to keep our users updated on what's happening in the world.</p>
            </div>
          </article>

          <article class="civica-service-item">
            <div class="civica-service-item__media">
              <img src="./assets/service-fact-checking.png" alt="Fact Checking icon">
            </div>
            <div class="civica-service-item__content">
              <h3>Fact Checking</h3>
              <p>We hate to see our viewers go misinformed. We do our best to make sure that everyone on this site gets 100% of the facts, no matter what.</p>
            </div>
          </article>
        </div>
      </section>

      <section class="civica-homepage__section">
        <div class="civica-homepage__featured-stack">
          <p class="civica-homepage__section-eyebrow">FEATURED</p>
          <p class="civica-homepage__section-caption">Here are some of our featured sites for the day.</p>
          <p class="civica-homepage__featured-timer" id="featured-timer">Resets in 00:00:00</p>
        </div>
        <div class="civica-homepage__featured-grid" id="featured-grid"></div>
      </section>

      <section class="civica-homepage__section civica-homepage__faq-section">
        <div class="civica-homepage__section-stack">
          <p class="civica-homepage__section-eyebrow">FAQ</p>
          <p class="civica-homepage__section-caption">Here are some of the questions we get a lot.</p>
        </div>

        <div class="civica-homepage__faq">
          <div class="civica-faq-item">
            <button class="civica-faq-item__question" type="button" aria-expanded="false">
              <span>Where does your data come from?</span>
            </button>
            <div class="civica-faq-item__answer-wrap">
              <div class="civica-faq-item__answer">
                <p>Our data is sourced from official government records, polling organizations, and historical archives.</p>
              </div>
            </div>
          </div>

          <div class="civica-faq-item">
            <button class="civica-faq-item__question" type="button" aria-expanded="false">
              <span>Do you provide global election coverage or only US data?</span>
            </button>
            <div class="civica-faq-item__answer-wrap">
              <div class="civica-faq-item__answer">
                <p>While we primarily focus on American elections, we include international elections and forecasts from time to time.</p>
              </div>
            </div>
          </div>

          <div class="civica-faq-item">
            <button class="civica-faq-item__question" type="button" aria-expanded="false">
              <span>Can I contribute data or insights?</span>
            </button>
            <div class="civica-faq-item__answer-wrap">
              <div class="civica-faq-item__answer">
                <p>Yes. If you have verified data or research, feel free to share it with us through our contributions page.</p>
              </div>
            </div>
          </div>

          <div class="civica-faq-item">
            <button class="civica-faq-item__question" type="button" aria-expanded="false">
              <span>Are you associated with any political party?</span>
            </button>
            <div class="civica-faq-item__answer-wrap">
              <div class="civica-faq-item__answer">
                <p>No, Civica is not associated with any political party. We are a nonpartisan platform committed to unbiased, fact-based reporting.</p>
              </div>
            </div>
          </div>

          <div class="civica-faq-item">
            <button class="civica-faq-item__question" type="button" aria-expanded="false">
              <span>Is Civica available for use for any personal projects or research?</span>
            </button>
            <div class="civica-faq-item__answer-wrap">
              <div class="civica-faq-item__answer">
                <p>Yes, but please check our <a href="./terms.html">terms of use</a> for guidelines on attribution and data usage.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="our-mission" class="civica-homepage__anchor-section" aria-label="Our mission"></section>
      <section id="our-team" class="civica-homepage__anchor-section" aria-label="Our team"></section>
    </main>

    <script>
      (function () {
        const dropdown = document.querySelector('.global-nav-dropdown');
        if (!dropdown) return;

        const trigger = dropdown.querySelector('.global-nav-dropdown__trigger');
        const menu = dropdown.querySelector('.global-nav-dropdown__menu');

        function closeMenu() {
          dropdown.classList.remove('is-open');
          trigger.setAttribute('aria-expanded', 'false');
          menu.hidden = true;
        }

        function openMenu() {
          dropdown.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
          menu.hidden = false;
        }

        trigger.addEventListener('click', function (event) {
          event.preventDefault();
          if (dropdown.classList.contains('is-open')) {
            closeMenu();
          } else {
            openMenu();
          }
        });

        document.addEventListener('click', function (event) {
          if (!dropdown.contains(event.target)) {
            closeMenu();
          }
        });

        document.addEventListener('keydown', function (event) {
          if (event.key === 'Escape') {
            closeMenu();
          }
        });
      })();

      (function () {
        const grid = document.getElementById('featured-grid');
        const timer = document.getElementById('featured-timer');
        if (!grid || !timer) return;

        const featuredPool = [
          {
            title: 'Presidential 2024',
            description: 'National map, county breakdowns, and the latest presidential movement.',
            href: './presidency-2024.html',
            media: './assets/featured-presidency-map-v2.svg'
          },
          {
            title: 'Senate 2024',
            description: 'State race coverage, seat control, and the tightest Senate battlegrounds.',
            href: './senate-2024.html',
            media: './assets/featured-senate-map-v2.svg'
          },
          {
            title: 'House 2024',
            description: 'District-level results, flips, and the path to House control.',
            href: './house-2024.html',
            media: './assets/featured-house-map-v2.svg'
          }
        ];

        function getPacificNow() {
          const now = new Date();
          const pacific = new Date(now.toLocaleString('en-US', { timeZone: 'America/Los_Angeles' }));
          const utcEquivalent = new Date(now.toLocaleString('en-US', { timeZone: 'UTC' }));
          return { pacific, offset: pacific.getTime() - utcEquivalent.getTime() };
        }

        function getPacificKey() {
          const { pacific } = getPacificNow();
          const y = pacific.getFullYear();
          const m = String(pacific.getMonth() + 1).padStart(2, '0');
          const d = String(pacific.getDate()).padStart(2, '0');
          return `${y}-${m}-${d}`;
        }

        function shuffleByKey(items, key) {
          let seed = Array.from(key).reduce(function (acc, ch) { return acc + ch.charCodeAt(0); }, 0);
          const copy = items.slice();
          for (let i = copy.length - 1; i > 0; i -= 1) {
            seed = (seed * 9301 + 49297) % 233280;
            const j = Math.floor((seed / 233280) * (i + 1));
            const temp = copy[i];
            copy[i] = copy[j];
            copy[j] = temp;
          }
          return copy;
        }

        function renderFeatured() {
          const items = shuffleByKey(featuredPool, getPacificKey()).slice(0, 3);
          grid.innerHTML = items.map(function (item) {
            return `
              <a class="civica-featured-panel" href="${item.href}">
                <div class="civica-featured-panel__media civica-featured-panel__media--image">
                  <img src="${item.media}" alt="${item.title} map preview">
                </div>
                <div class="civica-featured-panel__body">
                  <h3>${item.title}</h3>
                  <p>${item.description}</p>
                </div>
              </a>
            `;
          }).join('');
        }

        function updateTimer() {
          const { pacific, offset } = getPacificNow();
          const nextMidnightPacific = new Date(pacific);
          nextMidnightPacific.setHours(24, 0, 0, 0);
          const nextMidnightLocal = new Date(nextMidnightPacific.getTime() - offset);
          const diff = Math.max(0, nextMidnightLocal.getTime() - Date.now());

          const hours = String(Math.floor(diff / 3600000)).padStart(2, '0');
          const minutes = String(Math.floor((diff % 3600000) / 60000)).padStart(2, '0');
          const seconds = String(Math.floor((diff % 60000) / 1000)).padStart(2, '0');
          timer.textContent = `Resets in ${hours}:${minutes}:${seconds}`;
        }

        renderFeatured();
        updateTimer();

        let lastKey = getPacificKey();
        setInterval(function () {
          const key = getPacificKey();
          if (key !== lastKey) {
            lastKey = key;
            renderFeatured();
          }
          updateTimer();
        }, 1000);
      })();

      (function () {
        const items = Array.from(document.querySelectorAll('.civica-faq-item'));
        if (!items.length) return;

        items.forEach(function (item) {
          const button = item.querySelector('.civica-faq-item__question');
          button.addEventListener('click', function () {
            const isOpen = item.classList.contains('is-open');

            items.forEach(function (other) {
              other.classList.remove('is-open');
              const otherButton = other.querySelector('.civica-faq-item__question');
              otherButton.setAttribute('aria-expanded', 'false');
            });

            if (!isOpen) {
              item.classList.add('is-open');
              button.setAttribute('aria-expanded', 'true');
            }
          });
        });
      })();
    </script>
  </body>
</html>
